# nexxxen screen mode, started/stopped by nexxhub.service (only one screen mode owns tty1/HDMI at a time)
[Unit]
Description=nexxxen Artemis game streaming client (Apollo on the PC)
After=systemd-user-sessions.service user@1000.service network-online.target getty@tty1.service
Wants=user@1000.service
After=dev-dri-by\x2dpath-platform\x2dgpu\x2dcard.device
Wants=dev-dri-by\x2dpath-platform\x2dgpu\x2dcard.device
Conflicts=getty@tty1.service moonlight-kiosk.service nexx-visualizer.service nexx-kodi.service nexx-retroarch.service
ConditionPathExists=/dev/tty1

[Service]
Type=simple
User=cxfxcxb
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
WorkingDirectory=/home/cxfxcxb
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=LANG=en_GB.UTF-8
Environment=QT_QPA_PLATFORM=eglfs
# 1080p60 on HDMI2 (the TV prefers 4096x2160, which the Pi 4 drives at 30 Hz only)
Environment=QT_QPA_EGLFS_KMS_CONFIG=/etc/nexxhub/kms.json
# game sound -> PipeWire default sink; source-switch sees the artemis stream and selects the Pi input
Environment=SDL_AUDIODRIVER=pipewire
ExecStart=/usr/local/bin/artemis
Restart=no
